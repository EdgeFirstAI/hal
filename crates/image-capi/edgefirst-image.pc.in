# The prefix is relative to this file: `${pcfiledir}` is the directory holding
# this .pc file, <prefix>/lib/pkgconfig.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: edgefirst-image
Description: EdgeFirst hardware-accelerated image processing
Version: @VERSION@
Requires: edgefirst-tensor
Requires.private: edgefirst-decoder-abi
Libs: -L${libdir} -ledgefirst_image
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir}
