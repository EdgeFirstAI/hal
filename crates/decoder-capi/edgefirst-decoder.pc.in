# The prefix is relative to this file: `${pcfiledir}` is <prefix>/lib/pkgconfig.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: edgefirst-decoder
Description: EdgeFirst model output decoding
Version: @VERSION@
Requires: edgefirst-tensor
Requires.private: edgefirst-decoder-abi
Libs: -L${libdir} -ledgefirst_decoder
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir}
