#
# The base library: every sibling (edgefirst-image, and so on) declares
# `Requires: edgefirst-tensor`.

# Relocatable: the prefix is derived from this file's location.
# `${pcfiledir}` is the directory holding this .pc file, at
# <prefix>/lib/pkgconfig, so `../..` is the prefix.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: edgefirst-tensor
Description: EdgeFirst zero-copy tensor: handles, construction, and IPC
Version: @VERSION@
Libs: -L${libdir} -ledgefirst_tensor
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir}
