#
# Requires edgefirst-tensor: the tensor API is part of this library's interface.

# The prefix is relative to this file: `${pcfiledir}` is <prefix>/lib/pkgconfig.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: edgefirst-codec
Description: EdgeFirst image and video encode and decode
Version: @VERSION@
Requires: edgefirst-tensor
Libs: -L${libdir} -ledgefirst_codec
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir}
