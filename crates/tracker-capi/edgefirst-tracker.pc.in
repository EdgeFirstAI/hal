#
# `Requires.private: edgefirst-decoder` applies decoder's Cflags to every
# consumer and decoder's Libs only under `pkg-config --static`.
# `libedgefirst_tracker.so` has no DT_NEEDED entry for decoder or tensor.

# The prefix is relative to this file: `${pcfiledir}` is <prefix>/lib/pkgconfig.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: edgefirst-tracker
Description: EdgeFirst multi-object tracking
Version: @VERSION@
Requires.private: edgefirst-decoder
Libs: -L${libdir} -ledgefirst_tracker
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir}
