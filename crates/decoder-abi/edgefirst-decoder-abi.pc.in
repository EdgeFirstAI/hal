# Headers-only: provides `edgefirst/detect.h`.

# The prefix is relative to this file: `${pcfiledir}` is <prefix>/lib/pkgconfig.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: edgefirst-decoder-abi
Description: EdgeFirst detection vocabulary (header-only)
Version: @VERSION@
Cflags: -I${includedir}
