/dist
/target
# target/ directories inside the standalone leaf crates.
/crates/*/target/
/venv
__pycache__
*.pyc
*.pyo
*.pyd
*.wheel
*.egg
*.egg-info
*.log
cobertura.xml
coverage.xml
.DS_Store
*.jpg

# Test-output image dumps written into crate dirs by image comparison tests.
/crates/image/*.png

# `make sbom` output.
/sbom/
*sbom.json
*.cdx.json

env.sh

# Local notes: local caches of issues and tasks, at the repository root.
/TODO*.md
/BUG*.md
/FIX*.md
/FEATURE*.md
/SPS/
/WP1/
# Local-only planning / dev notes directory.
/docs/
*.profraw
.remember
.mcp.json

# Benchmark run outputs, build artifacts, and per-platform JSON dumps.
/benchmarks/results/**
!/benchmarks/results/.gitkeep
/benchmarks/**/target/
/benchmarks/modules/turbojpeg/build/
/benchmarks/modules/stb/build/
/benchmarks/modules/wuffs/build/
/benchmarks/imx*/
/benchmarks/rpi*/
/benchmarks/x86*/
/benchmarks/orin*/
/benchmarks/iq*/
/benchmarks/jetson*/
/benchmarks/maivin/
/benchmarks/*.json
/benchmarks/*.txt
/benchmarks/*.csv

# Local-only proof-of-concept spike projects.
/spikes/

# Large binary model artifacts kept outside the repo.
*.tflite
*.onnx
/benchmarks/docker/coco-smoke/

# Locally exported .pt/.onnx/.tflite models used by the schema-inference
# fixture capture script and its integration test.
/.ultralytics-exports/

# maturin develop drops built extensions into the package source tree
crates/python-*/python/edgefirst/*/_*.so
crates/python-*/python/edgefirst/*/_*.pyd
crates/python-*/python/edgefirst/*/_*.dylib

# python-tensor/build.rs copies libedgefirst_tensor.so (+ its .so.0
# symlink) into the package source tree.
crates/python-tensor/python/edgefirst/tensor/libedgefirst_tensor.so*
crates/python-tensor/python/edgefirst/tensor/libedgefirst_tensor.*.dylib
# Windows counterpart of the two lines above.
crates/python-tensor/python/edgefirst/tensor/edgefirst_tensor.dll
# The ANGLE runtime DLLs python-image's Windows wheel bundles beside
# _image.pyd.
crates/python-image/python/edgefirst/image/libEGL.dll
crates/python-image/python/edgefirst/image/libGLESv2.dll
crates/python-image/python/edgefirst/image/d3dcompiler_47.dll

# Subagent-driven-development scratch (ledgers, briefs, review packages).
/.superpowers/

# maturin develop drops the extension's PDB beside the .pyd on Windows
crates/python-*/python/edgefirst/*/*.pdb
